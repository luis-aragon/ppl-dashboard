{
  "name": "RP - LP API Ingesta de Leads",
  "nodes": [
    {
      "id": "cron-01",
      "name": "⏰ Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "id": "synclog-02",
      "name": "🗒️ Crear Sync Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        400
      ],
      "credentials": {
        "supabaseApi": {
          "id": "RELINK",
          "name": "RP Supabase"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://yqsdeufqbmkcznroieki.supabase.co/rest/v1/lp_sync_log",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'running', started_at: new Date().toISOString() }) }}"
      }
    },
    {
      "id": "extractid-03",
      "name": "🔑 Extraer Sync ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst record = Array.isArray(raw) ? raw[0] : raw;\nreturn [{ json: { sync_log_id: record.id } }];"
      }
    },
    {
      "id": "campaigns-04",
      "name": "📋 Obtener Campañas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        400
      ],
      "credentials": {
        "supabaseApi": {
          "id": "RELINK",
          "name": "RP Supabase"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "https://yqsdeufqbmkcznroieki.supabase.co/rest/v1/lp_campaigns",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "lp_campaign_id,name"
            },
            {
              "name": "active",
              "value": "eq.true"
            }
          ]
        }
      }
    },
    {
      "id": "prepare-05",
      "name": "🔧 Preparar Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const syncLogId = $('🔑 Extraer Sync ID').first().json.sync_log_id;\nconst raw = $input.first().json;\nconst campaigns = Array.isArray(raw) ? raw : [raw];\nreturn campaigns.map(c => ({ json: { lp_campaign_id: c.lp_campaign_id, name: c.name, sync_log_id: syncLogId } }));"
      }
    },
    {
      "id": "loop-06",
      "name": "🔁 Loop Campañas",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "synccampaign-07",
      "name": "🔄 Sync Campaña",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        260
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const campaignId = $json.lp_campaign_id;\nconst syncLogId = $json.sync_log_id;\n\nconst LP_KEY = $env.LP_API_KEY;\nconst SB_URL = 'https://yqsdeufqbmkcznroieki.supabase.co/rest/v1';\nconst SB_KEY = $env.SUPABASE_SERVICE_KEY;\n\nlet searchAfter = null;\nlet totalLeads = 0;\n\ndo {\n  const params = new URLSearchParams({ campaign: String(campaignId) });\n  if (searchAfter) params.set('search_after', searchAfter);\n\n  const leads = await this.helpers.httpRequest({\n    method: 'GET',\n    url: 'https://api.leadprosper.io/public/leads?' + params.toString(),\n    headers: { 'X-API-Key': LP_KEY },\n    returnFullResponse: false,\n  });\n\n  if (!Array.isArray(leads) || leads.length === 0) break;\n\n  const lastItem = leads[leads.length - 1];\n  searchAfter = lastItem.search_after || null;\n  totalLeads += leads.length;\n\n  const leadsClean = leads.map(function(lead) {\n    const cleaned = Object.assign({}, lead);\n    delete cleaned.search_after;\n    return cleaned;\n  });\n\n  await this.helpers.httpRequest({\n    method: 'POST',\n    url: SB_URL + '/lp_leads',\n    headers: {\n      'apikey': SB_KEY,\n      'Authorization': 'Bearer ' + SB_KEY,\n      'Content-Type': 'application/json',\n      'Prefer': 'resolution=merge-duplicates'\n    },\n    body: leadsClean,\n    json: true,\n    returnFullResponse: false,\n  });\n\n} while (searchAfter);\n\nreturn [{ json: { lp_campaign_id: campaignId, sync_log_id: syncLogId, total_leads: totalLeads } }];"
      }
    },
    {
      "id": "errorcampaign-08",
      "name": "📝 Registrar Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        560
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const errMsg = ($json.error && $json.error.message) ? $json.error.message : 'Error desconocido';\nconsole.log('Error en campaña ' + $json.lp_campaign_id + ': ' + errMsg);\nreturn [{ json: { lp_campaign_id: $json.lp_campaign_id, sync_log_id: $json.sync_log_id, had_error: true, error_message: errMsg } }];"
      }
    },
    {
      "id": "markok-09",
      "name": "✅ Marcar Sync OK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        400
      ],
      "credentials": {
        "supabaseApi": {
          "id": "RELINK",
          "name": "RP Supabase"
        }
      },
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://yqsdeufqbmkcznroieki.supabase.co/rest/v1/lp_sync_log?id=eq.' + $json.sync_log_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'success', finished_at: new Date().toISOString() }) }}"
      }
    },
    {
      "id": "email-10",
      "name": "📧 Email Resumen",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2000,
        400
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "RELINK",
          "name": "Gmail"
        }
      },
      "parameters": {
        "operation": "send",
        "sendTo": "luis@rpsolutions.io",
        "subject": "✅ LP Sync completado",
        "emailType": "text",
        "message": "={{ 'Sync de leads completado.\\nFecha: ' + new Date().toLocaleString('es-AR') }}"
      }
    }
  ],
  "connections": {
    "⏰ Cron": {
      "main": [
        [
          {
            "node": "🗒️ Crear Sync Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🗒️ Crear Sync Log": {
      "main": [
        [
          {
            "node": "🔑 Extraer Sync ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔑 Extraer Sync ID": {
      "main": [
        [
          {
            "node": "📋 Obtener Campañas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "📋 Obtener Campañas": {
      "main": [
        [
          {
            "node": "🔧 Preparar Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔧 Preparar Items": {
      "main": [
        [
          {
            "node": "🔁 Loop Campañas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔁 Loop Campañas": {
      "main": [
        [
          {
            "node": "🔄 Sync Campaña",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "✅ Marcar Sync OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔄 Sync Campaña": {
      "main": [
        [
          {
            "node": "🔁 Loop Campañas",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "📝 Registrar Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "📝 Registrar Error": {
      "main": [
        [
          {
            "node": "🔁 Loop Campañas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "✅ Marcar Sync OK": {
      "main": [
        [
          {
            "node": "📧 Email Resumen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
